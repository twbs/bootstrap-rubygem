source 'https://rubygems.org'

gem 'actionpack', '~> 7.0.4'
gem 'activesupport', '~> 7.0.4'
gem 'dartsass-sprockets', '~> 3.0'

gemspec path: '../../'

# json ~> 3 raises ArgumentError: unknown keyword: quirks_mode
gem 'json', '~> 2.7'

# no longer bundled as default gems in newer ruby
gem 'base64'
gem 'benchmark'
gem 'drb'
gem 'mutex_m'
gem 'ruby2_keywords'
gem 'tsort'
gem 'webrick'
